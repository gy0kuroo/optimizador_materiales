# Plantilla de variables; Django no carga este archivo automáticamente.
# Para producción: CUTLESS_ENV=production y clave aleatoria privada de 50+ caracteres.
CUTLESS_ENV=development
CUTLESS_SECRET_KEY=
CUTLESS_ALLOWED_HOSTS=localhost,127.0.0.1
CUTLESS_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Activar solo si un proxy controlado elimina y fija X-Forwarded-Proto.
CUTLESS_TRUST_PROXY_HEADERS=false
# CUTLESS_DB_PATH=C:/ruta/privada/db.sqlite3
# CUTLESS_MEDIA_ROOT=C:/ruta/privada/media
# CUTLESS_EMAIL_HOST=smtp.example.com
# CUTLESS_EMAIL_PORT=587
# CUTLESS_EMAIL_HOST_USER=
# CUTLESS_EMAIL_HOST_PASSWORD=
# CUTLESS_DEFAULT_FROM_EMAIL=CutLess <noreply@example.com>
